    ["Rate per minute", RATE_PER_MINUTE, "", ""],                                                 // 5
    ["Round GRAND TOTAL up to next whole minute? (TRUE/FALSE)", ROUND_UP_GRAND_TOTAL, "", ""],    // 6
    ["Outbound rule", `Skill matches ${OUTBOUND_SKILL_PATTERN.toString()}`, "", ""],              // 7
    ["", "", "", ""],                                                                             // 8
    ["TOTALS", "Excel formula", "Script", "Check"],                                               // 9
    ["Outbound calls billed", n > 0 ? `=ROWS(${rng("B")})` : "=0", n, chk(10, false)],             // 10
    ["Total seconds", sumF("J"), totalSec, chk(11, false)],                                       // 11
    ["Total seconds (independent formula parse)", sumF("K"), totalSec, chk(12, false)],           // 12
    ["Exact minutes (seconds / 60)", sumF("M"), totalSec / 60, chk(13, true)],                    // 13
    ["Grand total minutes, rounded up", "=ROUNDUP(B11/60,0)", roundedMin, chk(14, false)],        // 14
    ["Duration mismatches (script vs formula)", n > 0 ? `=COUNTIF(${rng("L")},"<>OK")` : "=0", 0, chk(15, false)], // 15
    ["", "", "", ""],                                                                             // 16
    ["Amount at exact minutes", "=ROUND(ROUND(B13*B5,6),2)", "", ""],                                      // 17
    ["Amount at rounded-up grand total", "=ROUND(B14*B5,2)", "", ""],                             // 18
    ["AMOUNT DUE (per setting in B6)", "=IF(B6,B18,B17)", "", ""],                                // 19
    ["Cross-check: sum of per-call charges (should equal exact amount)", n > 0 ? `=ROUND(ROUND(SUM(${rng("N")}),6),2)` : "=0", "", '=IF(ABS(B20-B17)<0.005,"PASS","FAIL")'], // 20
    ["", "", "", ""],                                                                             // 21
    ["RECONCILIATION (every source row accounted for)", "Rows", "", ""],                          // 22
    ["Data rows read from source", rowsRead, "", ""],                                             // 23
    ["  Billed", n, "", ""],                                                                      // 24
    ["  Excluded - not an outbound skill", counts.notOutbound, "", ""],                           // 25
    ["  Excluded - media type not billable", counts.notMedia, "", ""],                            // 26
    ["  Excluded - no Contact ID (footer/subtotal)", counts.noContactId, "", ""],                 // 27
    ["  Excluded - duplicate Contact ID", counts.duplicate, "", ""],                              // 28
    ["  ERROR - unreadable Duration (review!)", counts.badDuration, "", ""],                      // 29
    ["Rows reconcile?", "", "", "=IF(B23=SUM(B24:B29),\"PASS\",\"FAIL\")"],                       // 30
    ["Unreadable durations?", "", "", "=IF(B29=0,\"PASS\",\"REVIEW\")"],                          // 31
    ["", "", "", ""],                                                                             // 32
    ["FYI", "", "", ""],                                                                          // 33
    ["Transfer/child legs billed (Contact ID <> Master ID)", childLegs, "", ""],                  // 34
    ["Zero-second outbound calls", zeroSec, "", ""],                                              // 35
    ["Longest call (seconds)", longest, "", ""],                                                  // 36
    ["Blank rows skipped", blankRows, "", ""],                                                    // 37
    ["", "", "", ""],                                                                             // 38
    ["SKILL BREAKDOWN", "Rows", "Billed", "Billed Seconds"],                                      // 39
  ];
  const skills = Object.keys(skillStats).sort();
  for (const k of skills) rows.push([k, skillStats[k].rows, skillStats[k].billed, skillStats[k].seconds]);

  sum.getRange(`A1:D${rows.length}`).setValues(rows); // strings starting with "=" become formulas

  sum.getRange("A1").getFormat().getFont().setSize(16);
  sum.getRange("A1").getFormat().getFont().setBold(true);
  for (const a of ["A4:D4", "A9:D9", "A22:D22", "A33:D33", "A39:D39"]) styleHeader(sum.getRange(a));
  sum.getRange("B5:B6").getFormat().getFill().setColor("#FFF2CC");
  sum.getRange("B5").setNumberFormat("$0.0000");
  sum.getRange("B13:C13").setNumberFormat("0.0000");
  sum.getRange("B14:C14").setNumberFormat("0");
  sum.getRange("B17:B20").setNumberFormat("$#,##0.00");
  sum.getRange("A19:B19").getFormat().getFont().setBold(true);
  sum.getRange("A19:B19").getFormat().getFill().setColor("#E2EFDA");
  sum.getRange("A:D").getFormat().autofitColumns();
  sum.activate();

  console.log(`Billed ${n} outbound calls, ${totalSec} sec, ${roundedMin} min (grand total rounded up). ` +
    `Exact $${(Math.round(Number((totalSec / 60 * RATE_PER_MINUTE).toFixed(6)) * 100) / 100).toFixed(2)} | ` +
    `Rounded-up $${(Math.round(roundedMin * RATE_PER_MINUTE * 100) / 100).toFixed(2)}. ` +
    `Exceptions: ${exceptions.length}.`);
}

/** Lower-case, trim, drop trailing colon ("Start Time:" -> "start time"). */
function normHeader(v: Cell): string {
  return String(v).trim().replace(/:$/, "").trim().toLowerCase();
}

/** "m:ss" or "h:mm:ss" (text) -> seconds. Returns -1 if unreadable. */
function parseDuration(t: string): number {
  const s = t.trim();
  let m = s.match(/^(\d+):([0-5]\d)$/);
  if (m) return Number(m[1]) * 60 + Number(m[2]);
  m = s.match(/^(\d+):([0-5]\d):([0-5]\d)$/);
  if (m) return Number(m[1]) * 3600 + Number(m[2]) * 60 + Number(m[3]);
  return -1;
}

function styleHeader(r: ExcelScript.Range) {
  r.getFormat().getFont().setBold(true);
  r.getFormat().getFont().setColor("#FFFFFF");
  r.getFormat().getFill().setColor("#44546A");
}

