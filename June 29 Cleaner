      if (norm.indexOf("contact id") >= 0 && norm.indexOf("duration") >= 0) {
        source = ws;
        headerIdx = r;
        data = vals;
        firstRow = used.getRowIndex();
        break;
      }
    }
    if (source) break;
  }
  if (!source) {
    throw new Error("Could not find a sheet with 'Contact ID' and 'Duration' headers.");
  }

  const header = data[headerIdx].map((v) => normHeader(v));
  const col = (name: string, required: boolean): number => {
    const i = header.indexOf(normHeader(name));
    if (i < 0 && required) throw new Error(`Required column missing: "${name}"`);
    return i;
  };
  const cContact = col("Contact ID", true);
  const cMaster = col("Master Contact ID", false);
  const cMedia = col("Media Type", false);
  const cSkill = col("Skill", true);
  const cAgent = col("Agent", false);
  const cDnis = col("DNIS/To", false);
  const cAni = col("ANI/From", false);
  const cStart = col("Start Time", false);
  const cDur = col("Duration", true);
  const get = (row: Cell[], c: number): string => (c >= 0 && c < row.length ? String(row[c]).trim() : "");

  // ---------- 2. Classify every row ----------
  const billed: CallRow[] = [];
  const exceptions: Exception[] = [];
  const seen: { [id: string]: number } = {};
  const skillStats: { [skill: string]: { rows: number; billed: number; seconds: number } } = {};
  let rowsRead = 0, blankRows = 0;
  const counts = { notOutbound: 0, notMedia: 0, noContactId: 0, duplicate: 0, badDuration: 0 };

  for (let r = headerIdx + 1; r < data.length; r++) {
    const row = data[r];
    if (row.every((v) => String(v).trim() === "")) { blankRows++; continue; }
    rowsRead++;
    const sourceRow = firstRow + r + 1; // 1-based Excel row
    const contactId = get(row, cContact);
    const skill = get(row, cSkill);
    const media = get(row, cMedia);
    const durationText = get(row, cDur);
    const ex = (reason: string): Exception => ({ sourceRow, contactId, skill, media, durationText, reason });

    const sKey = skill === "" ? "(blank)" : skill;
    if (!skillStats[sKey]) skillStats[sKey] = { rows: 0, billed: 0, seconds: 0 };
