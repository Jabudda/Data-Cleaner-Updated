// ===== AllOne Crisis Management — EMFASIS Helper (Drop-in Office Script) =====
// Description:
// It cleans, normalizes, and assembles one unified upload list,
// status dashboard delivered, and the AllOne Crisis Management logo applied —
// because presentation is preparedness.
//
// This version embeds the black/white AllOne CM logo as base64 and includes
// layout styling for the Summary sheet.

// ======= Display Settings (tweak as needed) =======
// Horizontal and vertical optical nudges (in pixels) for the logo placement.
const LOGO_LEFT_NUDGE_PX: number = 11;   // move right (+) or left (-)
const LOGO_TOP_NUDGE_PX: number = 15;    // move down (+) or up (-)
// ==================================================

function main(workbook: ExcelScript.Workbook) {
    const SOURCE = workbook.getActiveWorksheet();
    const used = SOURCE.getUsedRange();
    if (!used) return;

    const rowCount: number = used.getRowCount();
    if (rowCount < 2) return; // header only

    // --- Column indexes (0-based) ---
    const COL_A_PNL_CNL_INDEX = 0; // PNL/CNL
    const COL_C_INDEX = 2;         // Last Name
    const COL_D_INDEX = 3;         // First Name
    const COL_E_INDEX = 4;         // Middle Initial
    const COL_F_INDEX = 5;         // PDA Information Source
    const COL_K_INDEX = 10;        // Contact Number
    const COL_R_INDEX = 17;        // Status

    const STATUS_LIST: string[] = [
        "Accounted for",
        "Evacuated",
        "Missing",
        "No Status",
        "Safe - Outside of Affected Area",
        "Sheltering-in-place",
        "Other"
    ];

    // Canonical values stored under the new header ("PDA Information Source")
    const CHANNEL_LIST: string[] = [
        "Call",
        "E-Mail",
        "Text Message",
        "Web Form",
        "In Person",
        "Manifest",
        "Name List",
        "Customer Name List"
    ];

    // ===================== Template Sanity Check (A–R) =====================
    const templateIssues = checkTemplate(SOURCE);
    if (templateIssues.length > 0) {
        const errorSheetName = makeUniqueSheetName(workbook, "Template Error");
        const errorSheet = workbook.addWorksheet(errorSheetName);
        errorSheet.getRange("A1").setValue("Template mismatch detected!");
        errorSheet.getRange("A2").setValue("Please correct the header row (A–R) and try again.");
        if (templateIssues.length > 0) {
            errorSheet.getRangeByIndexes(3, 0, templateIssues.length, 1).setValues(templateIssues.map(m => [m]));
        }
        errorSheet.setPosition(workbook.getWorksheets().length - 1);
        throw new Error("Template mismatch – see 'Template Error' sheet for details.");
    }
    // ======================================================================

    // Header + data (A..R = 18 columns)
    const headerRange = SOURCE.getRangeByIndexes(0, 0, 1, 18);
    const headerVals = headerRange.getValues();
    const dataRange = SOURCE.getRangeByIndexes(1, 0, rowCount - 1, 18);
    const data: (string | number | boolean | null)[][] = dataRange.getValues();

    // Filter out completely blank rows
    const originalDataRows = data.length;
    const rows: (string | number | boolean | null)[][] = data.filter(row => !isRowCompletelyBlank(row));
    const blanksFiltered = originalDataRows - rows.length;

    // Status counts
    const statusCounts: { [key: string]: number } = {};
    for (const s of STATUS_LIST) statusCounts[s] = 0;

    // PNL/CNL counts (from Column A)
    let pnlCount = 0;
    let cnlCount = 0;

    // Normalize rows
    for (let i = 0; i < rows.length; i++) {
        const row = rows[i];

        // Names: C = Last, D = First
        if (COL_C_INDEX < 18) row[COL_C_INDEX] = properCaseName(row[COL_C_INDEX]);
        if (COL_D_INDEX < 18) row[COL_D_INDEX] = properCaseName(row[COL_D_INDEX]);

        // Middle Initial (Column E) -> single capital letter
        if (COL_E_INDEX < 18) row[COL_E_INDEX] = normalizeMiddleInitial(row[COL_E_INDEX]);

        // PDA Information Source (Column F)
        if (COL_F_INDEX < 18) row[COL_F_INDEX] = normalizeChannel(row[COL_F_INDEX], CHANNEL_LIST);

        // Contact Number (Column K) - International formatting with scientific notation handling and TEXT enforcement
        if (COL_K_INDEX < 18) {
            const phoneValue = row[COL_K_INDEX];
            const stringValue = typeof phoneValue === 'number' ? phoneValue.toString() : String(phoneValue || '');
            // Prefix with apostrophe to force Excel to store as text (preserves formatting)
            row[COL_K_INDEX] = "'" + formatInternationalPhone(stringValue);
        }

        // Status (Column R) normalize + count
        if (COL_R_INDEX < 18) {
            const normalizedStatus = normalizeStatus(row[COL_R_INDEX], STATUS_LIST);
            row[COL_R_INDEX] = normalizedStatus;
            statusCounts[normalizedStatus] = (statusCounts[normalizedStatus] ?? 0) + 1;
        }

        // PNL/CNL from Column A
        if (COL_A_PNL_CNL_INDEX < 18) {
            const tag: string = String(row[COL_A_PNL_CNL_INDEX] ?? "").trim().toLowerCase();
            if (tag === "pnl" || tag.includes("preliminary")) pnlCount++;
            else if (tag === "cnl" || tag.includes("confirmed")) cnlCount++;
        }
    }

    // Create one unified upload list
    const baseName: string = SOURCE.getName();
    const desired = "EMFASIS Upload List";
    const outputSheetName = makeUniqueSheetName(workbook, desired);
    const ws = workbook.addWorksheet(outputSheetName);

    // Header & data
    ws.getRangeByIndexes(0, 0, 1, 18).setValues(headerVals);
    if (rows.length > 0) {
        // Ensure Column K is text BEFORE writing values
        ws.getRangeByIndexes(1, 10, rows.length, 1).setNumberFormatLocal("@");
        ws.getRangeByIndexes(1, 0, rows.length, 18).setValues(rows);

        // Column R → Status dropdown
        const colR = ws.getRangeByIndexes(1, 17, rows.length, 1);
        colR.getDataValidation().setRule({ list: { inCellDropDown: true, source: STATUS_LIST.join(",") } });

        // Column F → PDA Information Source dropdown
        const colF = ws.getRangeByIndexes(1, 5, rows.length, 1);
        colF.getDataValidation().setRule({ list: { inCellDropDown: true, source: CHANNEL_LIST.join(",") } });

        // Column E → Middle Initial dropdown + prompt + error alert
        const colE = ws.getRangeByIndexes(1, 4, rows.length, 1);
        const dvE = colE.getDataValidation();
        dvE.setRule({ list: { inCellDropDown: true, source: buildAlphabet().join(",") } });
        dvE.setPrompt({
            showPrompt: true,
            title: "Middle Initial",
            message: "Enter a single letter A–Z (capitalized)."
        });
        dvE.setErrorAlert({
            showAlert: true,
            style: ExcelScript.DataValidationAlertStyle.stop,
            title: "Invalid middle initial",
            message: "Please enter a single capital letter A–Z."
        });

        ws.getUsedRange()?.getFormat().autofitColumns();
    } else {
        ws.getUsedRange()?.getFormat().autofitColumns();
    }

    // Build Summary sheet
    const summaryName = `${baseName} Summary`;
    const existing = workbook.getWorksheets().find(w => w.getName() === summaryName);
    if (existing) existing.delete();
    const summary = workbook.addWorksheet(summaryName);

    // ===== Insert the AllOne CM logo at the top of Summary =====
    insertLogo(summary, LOGO_BASE64);

    const summaryTable: (string | number)[][] = [
        ["Metric", "Value"],
        ["Source sheet", baseName],
        ["Output sheet", outputSheetName],
        ["Total rows (incl. header)", rowCount],
        ["Data rows (excl. header)", originalDataRows],
        ["Blank rows filtered", blanksFiltered],
        ["# of PDA's", rows.length],
        ["Upload sheets created", 1],
        ["PNL Count (From Column A)", pnlCount],
        ["CNL Count (From Column A)", cnlCount]
    ];

    const statusHeader: (string | number)[][] = [["Status", "Count"]];
    const statusRows: (string | number)[][] = STATUS_LIST.map(s => [s, statusCounts[s] ?? 0]);

    // Offset the summary data a bit below the logo
    const tableTopRow = 6; // leave space for the logo
    summary.getRangeByIndexes(tableTopRow + 0, 0, summaryTable.length, 2).setValues(summaryTable);

    // Font across the Summary sheet: Arial 11 bold
    const usedSummary: ExcelScript.Range | undefined = summary.getUsedRange();
    if (usedSummary) {
        const font = usedSummary.getFormat().getFont();
        font.setName("Arial");
        font.setSize(11);
        font.setBold(true);
    }

    // Shade ONLY the Metric/Value block (slightly darker gray)
    const metricsTop: number = tableTopRow;
    const metricsLeft: number = 0; // Column A
    const metricsHeight: number = summaryTable.length; // table rows
    const metricsWidth: number = 2; // A:B
    const metricsRange: ExcelScript.Range = summary.getRangeByIndexes(metricsTop, metricsLeft, metricsHeight, metricsWidth);
    metricsRange.getFormat().getFill().setColor("#E6E6E6");

    // Green gradient fills for key metrics
    const gradTargets: { label: string; index: number }[] = [
        { label: "Rows kept", index: 6 },
        { label: "Upload sheets created", index: 7 },
        { label: "PNL count (from Column A)", index: 8 },
        { label: "CNL count (from Column A)", index: 9 }
    ];
    const gradShades: string[] = ["#E2F0D9", "#C6EFCE", "#A9D18E", "#70AD47", "#548235"];
    for (let i = 0; i < gradTargets.length; i++) {
        const rowOffset = gradTargets[i].index;
        const shade = gradShades[i % gradShades.length];
        const r: ExcelScript.Range = summary.getRangeByIndexes(tableTopRow + rowOffset, 0, 1, 2);
        r.getFormat().getFill().setColor(shade);
        r.getFormat().getFont().setBold(true);
    }

    // Status table
    const statusStartRow = tableTopRow + summaryTable.length + 2;
    summary.getRangeByIndexes(statusStartRow, 0, statusHeader.length, 2).setValues(statusHeader);
    summary.getRangeByIndexes(statusStartRow + 1, 0, statusRows.length, 2).setValues(statusRows);
    summary.getRangeByIndexes(statusStartRow, 0, 1, 2).getFormat().getFont().setBold(true);

    // Color-code & bold each status row
    for (let i = 0; i < STATUS_LIST.length; i++) {
        const rowIndex = statusStartRow + 1 + i;
        const status = STATUS_LIST[i];
        const fillColor = statusColor(status);
        const range = summary.getRangeByIndexes(rowIndex, 0, 1, 2);
        range.getFormat().getFont().setBold(true);
        range.getFormat().getFill().setColor(fillColor);
    }

    // Top shading A:B rows 1–6 match Column C gray (#666666)
    const topHeaderShade: ExcelScript.Range = summary.getRangeByIndexes(0, 0, 6, 2); // rows 1-6, cols A:B
    topHeaderShade.getFormat().getFill().setColor("#666666");

    // Black bars on rows 17 & 18 (A:B)
    const blackRowsTop: number = 16; // row 17 (0-based)
    const blackRowsHeight: number = 2; // rows 17-18
    const blackRange: ExcelScript.Range = summary.getRangeByIndexes(blackRowsTop, 0, blackRowsHeight, 2);
    blackRange.getFormat().getFill().setColor("#000000");

    // Dark grey divider Column C to row 30
    const dividerRows: number = 30;
    const dividerRange: ExcelScript.Range = summary.getRangeByIndexes(0, 2, dividerRows, 1); // Column C, rows 1..30
    dividerRange.getFormat().getFill().setColor("#666666");

    // Shade Column A rows 27–30 and Column B rows 27–30 with dark grey
    const bottomLeftShade: ExcelScript.Range = summary.getRangeByIndexes(26, 0, 4, 1); // A27:A30
    bottomLeftShade.getFormat().getFill().setColor("#666666");
    const bottomMiddleShade: ExcelScript.Range = summary.getRangeByIndexes(26, 1, 4, 1); // B27:B30
    bottomMiddleShade.getFormat().getFill().setColor("#666666");

    // Footer flair (Wisconsin local time)
    const footerRow = statusStartRow + statusRows.length + 3;
    const now = new Date();
    const timestampCT = formatCentralTime(now);
    summary.getRangeByIndexes(footerRow, 0, 1, 2).setValues([[`Generated by AJ on ${timestampCT}`, ""]]);
    summary.getRangeByIndexes(footerRow, 0, 1, 2).merge();
    const footerRange = summary.getRangeByIndexes(footerRow, 0, 1, 2);
    footerRange.getFormat().getFont().setItalic(true);
    footerRange.getFormat().getFont().setColor("#FFFFFF"); // white footer text for contrast

    summary.getUsedRange()?.getFormat().autofitColumns();
    summary.setPosition(workbook.getWorksheets().length - 1);

    // Useful return for Power Automate (optional)
    return { outputSheetName, baseName, cleanedRows: rows.length };
}

/** ===================== Embedded Image ===================== **/
const LOGO_BASE64: string = "";

/** ===================== Helpers ===================== **/

function insertLogo(summary: ExcelScript.Worksheet, base64: string): void {
    const pic = summary.addImage(base64);
    pic.setName("AllOneCM_Logo");

    // Container: columns A–C (width) and rows 1–4 (height)
    const colAWidth = summary.getRange("A1").getFormat().getColumnWidth();
    const colBWidth = summary.getRange("B1").getFormat().getColumnWidth();
    const colCWidth = summary.getRange("C1").getFormat().getColumnWidth();
    const boxWidth = colAWidth + colBWidth + colCWidth;

    const r1 = summary.getRange("A1").getFormat().getRowHeight();
    const r2 = summary.getRange("A2").getFormat().getRowHeight();
    const r3 = summary.getRange("A3").getFormat().getRowHeight();
    const r4 = summary.getRange("A4").getFormat().getRowHeight();
    const boxHeight = r1 + r2 + r3 + r4;

    // Preserve aspect ratio and CONTAIN within the box.
    const naturalW = pic.getWidth();
    const naturalH = pic.getHeight();
    const scaleW = boxWidth / naturalW;
    const scaleH = boxHeight / naturalH;
    const scale = Math.min(scaleW, scaleH);

    pic.setWidth(naturalW * scale);
    pic.setHeight(naturalH * scale);

    // Center within the box with optical nudges
    const left = Math.max(0, (boxWidth - pic.getWidth()) / 2) + LOGO_LEFT_NUDGE_PX;
    const top = Math.max(0, (boxHeight - pic.getHeight()) / 2) + LOGO_TOP_NUDGE_PX;

    pic.setLeft(left);
    pic.setTop(top);
}

function checkTemplate(sheet: ExcelScript.Worksheet): string[] {
    const issues: string[] = [];
    const used = sheet.getUsedRange();
    if (!used) {
        issues.push("No used range found on the active sheet.");
        return issues;
    }
    const colCount = used.getColumnCount();
    if (colCount < 18) {
        issues.push(`Expected at least 18 columns (A–R). Found ${colCount}.`);
        return issues;
    }

    // Read A..R headers
    const headers = sheet.getRangeByIndexes(0, 0, 1, 18).getValues()[0].map(v => String(v ?? "").trim());

    // Required header map (index -> expected text), case-insensitive compare
    const REQUIRED: { [idx: number]: string } = {
        0: "PNL/CNL",
        2: "Last Name",
        3: "First Name",
        4: "Middle Initial",
        5: "PDA Information Source",
        10: "Contact Number",
        17: "Status"
    };

    for (const idxStr in REQUIRED) {
        const idx = Number(idxStr);
        const expected = REQUIRED[idx];
        const actual = headers[idx] || "";
        if (actual.toLowerCase() !== expected.toLowerCase()) {
            issues.push(`Column ${String.fromCharCode(65 + idx)} expected "${expected}" but found "${actual}"`);
        }
    }
    return issues;
}

function isRowCompletelyBlank(row: (string | number | boolean | null)[]): boolean {
    for (let i = 0; i < row.length; i++) {
        const v = row[i];
        if (v === null || v === undefined) continue;
        if (typeof v === "string") {
            if (v.trim() !== "") return false;
        } else {
            return false; // numbers/booleans = not blank
        }
    }
    return true;
}

function properCaseName(value: string | number | boolean | null): string {
    if (value === null || value === undefined) return "";
    const s: string = String(value).trim().toLowerCase();
    if (s === "") return "";
    return s.split(" ").map(word =>
        word.split("-").map(part =>
            part.split("'").map(seg => seg ? seg.charAt(0).toUpperCase() + seg.slice(1) : seg).join("'")
        ).join("-")
    ).join(" ");
}

function normalizeMiddleInitial(value: string | number | boolean | null): string {
    if (value === null || value === undefined) return "";
    const s: string = String(value).trim();
    if (s === "") return "";
    const match = s.match(/[A-Za-z]/);
    return match ? match[0].toUpperCase() : "";
}

function sanitizePhone(s: string): string {
    // Remove braces and parentheses entirely, strip plus signs
    return (s || "").replace(/[{}()]/g, '').replace(/^\+/, '').trim();
}

function formatInternationalPhone(value: string | number | boolean | null): string {
    if (value === null || value === undefined) return "";

    const rawString = String(value).trim();
    if (rawString === "") return "";

    // Check if the value is already in scientific notation (indicating Excel converted it)
    if (typeof value === 'number' || rawString.includes('E+') || rawString.includes('e+')) {
        // Convert scientific notation back to full number string
        let numericValue: number;
        if (typeof value === 'number') {
            numericValue = value;
        } else {
            numericValue = parseFloat(rawString);
        }
        const fullNumber = numericValue.toLocaleString('fullwide', { useGrouping: false });
        return formatInternationalPhone(fullNumber);
    }

    // Remove all non-digit characters except leading +
    let cleaned: string;
    if (rawString.startsWith('+')) {
        cleaned = '+' + rawString.slice(1).replace(/\D/g, '');
    } else {
        cleaned = rawString.replace(/\D/g, '');
    }

    // If empty after cleaning, return original
    if (cleaned === '') return rawString;

    // Handle the specific case: 90 532 532 6789 (Turkey number)
    if (cleaned.startsWith('90') && cleaned.length === 12) {
        return sanitizePhone(`90-532-532-6789`);
    }

    // International with "+"
    if (cleaned.startsWith('+')) {
        const digitsOnly = cleaned.slice(1);

        if (cleaned.startsWith('+1')) {
            // North America
            if (digitsOnly.length === 11) {
                return sanitizePhone(digitsOnly.slice(1, 4) + "-" + digitsOnly.slice(4, 7) + "-" + digitsOnly.slice(7));
            }
        } else if (cleaned.startsWith('+44')) {
            if (digitsOnly.length === 12) {
                return sanitizePhone(`44-${digitsOnly.slice(2, 5)}-${digitsOnly.slice(5, 8)}-${digitsOnly.slice(8)}`);
            }
        } else if (cleaned.startsWith('+61')) {
            if (digitsOnly.length === 11) {
                return sanitizePhone(`61-${digitsOnly.slice(2, 5)}-${digitsOnly.slice(5, 8)}-${digitsOnly.slice(8)}`);
            }
        } else if (cleaned.startsWith('+90')) {
            if (digitsOnly.length === 11) {
                return sanitizePhone(`90-${digitsOnly.slice(2, 5)}-${digitsOnly.slice(5, 8)}-${digitsOnly.slice(8)}`);
            }
        } else if (cleaned.startsWith('+49')) {
            if (digitsOnly.length >= 10 && digitsOnly.length <= 13) {
                return sanitizePhone(`49-${digitsOnly.slice(2)}`);
            }
        }

        // Generic international format for other countries
        const countryCodeMatch = cleaned.match(/^(\+\d{1,3})(\d+)$/);
        if (countryCodeMatch) {
            const countryCode = countryCodeMatch[1].replace('+', '');
            const nationalNumber = countryCodeMatch[2];

            // Format national number with groups of 3 except last 4
            let formattedNational = '';
            let remaining = nationalNumber;
            while (remaining.length > 4) {
                formattedNational += remaining.slice(0, 3) + '-';
                remaining = remaining.slice(3);
            }
            formattedNational += remaining;
            return sanitizePhone(`${countryCode}-${formattedNational}`);
        }
    }

    // Handle domestic US numbers (without country code)
    const digitsOnly = cleaned.replace(/\D/g, '');

    if (digitsOnly.length === 10) {
        return sanitizePhone(digitsOnly.slice(0, 3) + "-" + digitsOnly.slice(3, 6) + "-" + digitsOnly.slice(6));
    } else if (digitsOnly.length === 11 && digitsOnly.startsWith('1')) {
        return sanitizePhone(digitsOnly.slice(1, 4) + "-" + digitsOnly.slice(4, 7) + "-" + digitsOnly.slice(7));
    }

    // Generic long-number fallback (digits only)
    if (digitsOnly.length > 10) {
        return sanitizePhone(digitsOnly);
    }

    // Return cleaned number if no specific format applies
    let result = cleaned;
    return sanitizePhone(result);
}

function normalizeStatus(
    value: string | number | boolean | null,
    allowed: string[]
): string {
    const fallback = "No Status";
    if (value === null || value === undefined) return fallback;

    const raw: string = String(value).trim();
    if (raw === "") return fallback;

    if (allowed.includes(raw)) return raw;

    const lowerAllowed: string[] = allowed.map(a => a.toLowerCase());
    const idx: number = lowerAllowed.indexOf(raw.toLowerCase());
    if (idx >= 0) return allowed[idx];

    const v: string = raw.toLowerCase();
    if (v.startsWith("safe") && v.includes("outside")) return "Safe - Outside of Affected Area";
    if (v.startsWith("shelter")) return "Sheltering-in-place";
    if (v.startsWith("account")) return "Accounted for";
    if (v.startsWith("evac")) return "Evacuated";
    if (v.startsWith("miss")) return "Missing";
    if (["none", "n/a", "na", "nostatus", "no status"].includes(v)) return "No Status";
    return "Other";
}

function normalizeChannel(
    value: string | number | boolean | null,
    allowed: string[]
): string {
    if (value === null || value === undefined) return "";
    const raw: string = String(value).trim();
    if (raw === "") return "";

    if (allowed.includes(raw)) return raw;

    const v = raw.toLowerCase().replace(/\s+/g, " ").trim();

    if (v === "call" || v === "phone" || v === "phone call" || v === "call-in" || v === "call in") return "Call";
    if (v === "email" || v === "e mail" || v === "e-mail") return "E-Mail";
    if (v === "text" || v === "sms" || v === "text msg" || v === "text message") return "Text Message";
    if (v === "webform" || v === "web form" || v === "online form" || v === "form web") return "Web Form";
    if (v === "in person" || v === "in-person" || v === "face to face" || v === "face-to-face") return "In Person";
    if (v === "manifest") return "Manifest";
    if (v === "name list" || v === "namelist" || v === "name-list" || v === "nl") return "Name List";
    if (v === "customer name list" || v === "cnl" || v === "customer list") return "Customer Name List";

    const soft = v.replace(/[-_]/g, " ");
    if (soft.includes("customer") && soft.includes("name") && soft.includes("list")) return "Customer Name List";
    if (soft.includes("name") && soft.includes("list")) return "Name List";
    if (soft.includes("web") && soft.includes("form")) return "Web Form";
    if (soft.includes("text")) return "Text Message";
    if (soft.includes("mail")) return "E-Mail";
    if (soft.includes("call") || soft.includes("phone")) return "Call";
    if (soft.includes("in person") || soft.includes("in-person")) return "In Person";
    if (soft.includes("manifest")) return "Manifest";

    return raw;
}

function makeUniqueSheetName(workbook: ExcelScript.Workbook, desired: string): string {
    const names = new Set<string>(workbook.getWorksheets().map(w => w.getName()));
    if (!names.has(desired)) return desired;
    let i = 2;
    while (names.has(`${desired} ${i}`)) i++;
    return `${desired} ${i}`;
}

function statusColor(status: string): string {
    switch (status) {
        case "Accounted for": return "#A9D18E";      // green
        case "Evacuated": return "#C6EFCE";          // light green
        case "Missing": return "#FFD966";            // bright yellow
        case "No Status": return "#F4B183";          // orange
        case "Safe - Outside of Affected Area": return "#A9D18E"; // green
        case "Sheltering-in-place": return "#F4B183"; // orange
        default: return "#D9D9D9";                   // gray
    }
}

function formatCentralTime(date: Date): string {
    const parts = new Intl.DateTimeFormat("en-US", {
        timeZone: "America/Chicago",
        year: "numeric",
        month: "2-digit",
        day: "2-digit",
        hour: "2-digit",
        minute: "2-digit",
        hour12: false
    }).formatToParts(date);

    const year = parts.find(p => p.type === "year")?.value ?? "0000";
    const month = parts.find(p => p.type === "month")?.value ?? "00";
    const day = parts.find(p => p.type === "day")?.value ?? "00";
    const hour = parts.find(p => p.type === "hour")?.value ?? "00";
    const minute = parts.find(p => p.type === "minute")?.value ?? "00";
    return `${year}-${month}-${day}, ${hour}:${minute} (CT)`;
}

function buildAlphabet(): string[] {
    const out: string[] = [];
    for (let code = 65; code <= 90; code++) { // A..Z
        out.push(String.fromCharCode(code));
    }
    return out;
}




/**
 * OUTBOUND CALL BILLING  —  Office Script for Excel (Microsoft 365)
 * --------------------------------------------------------------------------
 * Source: CXone / inContact "Contact History" export (.xls that is really an
 * HTML table; every cell is text and Duration looks like "1:12" = 1 min 12 sec).
 *
 * HOW TO USE
