  const exc = workbook.addWorksheet(EXCEPTION_SHEET);
  const S = `'${SUMMARY_SHEET}'`;
  const D = `'${DETAIL_SHEET}'`;

  // ---- Detail sheet ----
  const detHeaders = ["Source Row", "Contact ID", "Master Contact ID", "Skill", "Agent", "DNIS/To", "ANI/From",
    "Start Time", "Duration (as exported)", "Seconds (script)", "Seconds (formula check)", "Match?",
    "Exact Minutes", "Charge (exact, before grand-total rounding)"];
  det.getRange("A1:N1").setValues([detHeaders]);
  styleHeader(det.getRange("A1:N1"));
  const last = n + 1; // last data row on detail sheet
  if (n > 0) {
    const textBlock = det.getRange(`A2:I${last}`);
    textBlock.setNumberFormat("@"); // keep IDs, phone numbers and "1:12" as text
    textBlock.setValues(billed.map((c) => [String(c.sourceRow), c.contactId, c.masterId, c.skill, c.agent,
      c.dnis, c.ani, c.start, c.durationText]));
    det.getRange(`J2:J${last}`).setValues(billed.map((c) => [c.seconds]));
    const f: string[][] = [];
    for (let i = 2; i <= last; i++) {
      const h = `I${i}`;
      f.push([
        // Independent parse of "m:ss" or "h:mm:ss" text using Excel itself
        `=IFERROR(IF(LEN(${h})-LEN(SUBSTITUTE(${h},":",""))=1,LEFT(${h},FIND(":",${h})-1)*60+RIGHT(${h},2),` +
          `LEFT(${h},FIND(":",${h})-1)*3600+MID(${h},FIND(":",${h})+1,2)*60+RIGHT(${h},2)),"ERR")`,
        `=IF(J${i}=K${i},"OK","MISMATCH")`,
        `=J${i}/60`,
        `=M${i}*${S}!$B$5`,
      ]);
    }
    det.getRange(`K2:N${last}`).setFormulas(f);
    det.getRange(`M2:M${last}`).setNumberFormat("0.0000");
    det.getRange(`N2:N${last}`).setNumberFormat("$#,##0.0000");
  }
  det.getFreezePanes().freezeRows(1);
  det.getRange("A:N").getFormat().autofitColumns();

  // ---- Exceptions sheet ----
  exc.getRange("A1:F1").setValues([["Source Row", "Contact ID", "Skill", "Media Type", "Duration", "Reason"]]);
  styleHeader(exc.getRange("A1:F1"));
  if (exceptions.length > 0) {
    const r = exc.getRange(`A2:F${exceptions.length + 1}`);
    r.setNumberFormat("@");
    r.setValues(exceptions.map((e) => [String(e.sourceRow), e.contactId, e.skill, e.media, e.durationText, e.reason]));
